#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

LOG=""
TARGET_READY=0

run_zenity() {
    runuser -u "$REAL_USER" -- env \
        HOME="$REAL_HOME" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        zenity "$@"
}

cleanup() {
    set +e
    if swapon --show=NAME 2>/dev/null | grep -qx '/mnt/swap/swapfile'; then
        swapoff /mnt/swap/swapfile
    fi
    if mountpoint -q /var/cache/pacman/pkg; then
        umount /var/cache/pacman/pkg
    fi
}
trap cleanup EXIT

fail() {
    local line="$1"
    local code="$2"

    set +e
    echo
    echo "ERROR: GayOS Installer failed at line $line (exit $code)."

    if [[ "$TARGET_READY" == "1" && -n "$LOG" ]]; then
        echo "Log saved at: $LOG"
        run_zenity --error \
            --title="GayOS Installer Error" \
            --text="Installation stopped safely.\n\nLog saved on the target disk:\n$LOG\n\nDo not reboot before copying the log." \
            --width=600 || true
    else
        run_zenity --error \
            --title="GayOS Installer Error" \
            --text="Installation stopped before target logging was ready.\n\nRead the terminal output." \
            --width=600 || true
    fi

    exit "$code"
}
trap 'fail $LINENO $?' ERR

if [[ "${EUID}" -ne 0 ]]; then
    exec sudo -E /usr/local/bin/gayos-install "$@"
fi

REAL_USER="${SUDO_USER:-gay}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
REAL_UID="$(id -u "$REAL_USER")"

export XDG_RUNTIME_DIR="/run/user/$REAL_UID"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

if ! run_zenity --question \
    --title="GayOS Installer" \
    --text="Welcome to GayOS Installer.\n\nThis installs GayOS with Btrfs, Snapper, full Caelestia Dots, Paru, GRUB branding, Fastfetch branding, and SSH recovery.\n\nWARNING: All data on the selected disk will be erased." \
    --ok-label="I AM GAY" \
    --cancel-label="Cancel" \
    --width=650; then
    exit 0
fi

mapfile -t DISKS < <(lsblk -dpno NAME,TYPE,SIZE,MODEL | awk '$2 == "disk" {print $1 " (" $3 ") " substr($0, index($0,$4))}')

[[ "${#DISKS[@]}" -gt 0 ]] || {
    run_zenity --error --title="GayOS Installer" --text="No installable disk was found."
    exit 1
}

ZENITY_ROWS=()
for item in "${DISKS[@]}"; do
    disk_path="${item%% *}"
    ZENITY_ROWS+=(FALSE "$disk_path" "${item#"$disk_path "}")
done

DISK="$(run_zenity --list --radiolist \
    --title="Choose installation disk" \
    --text="Select the disk GayOS may erase." \
    --column="Select" \
    --column="Disk" \
    --column="Size and model" \
    "${ZENITY_ROWS[@]}" \
    --width=720 --height=360)" || exit 0

[[ -n "$DISK" && -b "$DISK" ]] || exit 0

if ! run_zenity --question \
    --title="Final confirmation" \
    --text="ALL DATA ON:\n\n$DISK\n\nwill be permanently erased.\n\nContinue?" \
    --ok-label="Erase and install" \
    --cancel-label="Cancel" \
    --width=560; then
    exit 0
fi

HOSTNAME="$(run_zenity --entry \
    --title="Hostname" \
    --text="Name this GayOS machine:" \
    --entry-text="gayos")" || exit 0
HOSTNAME="${HOSTNAME:-gayos}"

USERNAME="$(run_zenity --entry \
    --title="Create user" \
    --text="Choose your primary username:" \
    --entry-text="gay")" || exit 0
USERNAME="${USERNAME:-gay}"

[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || {
    run_zenity --error --title="GayOS Installer" --text="Invalid username."
    exit 1
}

PASSWD1="$(run_zenity --password \
    --title="Primary password" \
    --text="Password for $USERNAME:")" || exit 0

PASSWD2="$(run_zenity --password \
    --title="Confirm password" \
    --text="Enter the same password again:")" || exit 0

[[ -n "$PASSWD1" && "$PASSWD1" == "$PASSWD2" ]] || {
    run_zenity --error --title="GayOS Installer" --text="Passwords are empty or do not match."
    exit 1
}

echo "=== Step 1: Prepare target disk ==="
swapoff -a 2>/dev/null || true
umount -R /mnt 2>/dev/null || true

wipefs -af "$DISK"
sgdisk --zap-all "$DISK"

if [[ -d /sys/firmware/efi ]]; then
    BOOT_MODE="uefi"
else
    BOOT_MODE="bios"
fi

echo "Boot mode: $BOOT_MODE"

if [[ "$BOOT_MODE" == "uefi" ]]; then
    sgdisk --clear \
        --new=1:1MiB:+512MiB \
        --typecode=1:EF00 \
        --change-name=1:"GAYOS_EFI" \
        --new=2:0:0 \
        --typecode=2:8300 \
        --change-name=2:"GAYOS_ROOT" \
        "$DISK"
else
    sgdisk --clear \
        --new=1:1MiB:+2MiB \
        --typecode=1:EF02 \
        --change-name=1:"GAYOS_BIOS" \
        --new=2:0:0 \
        --typecode=2:8300 \
        --change-name=2:"GAYOS_ROOT" \
        "$DISK"
fi

partprobe "$DISK"
udevadm settle
sleep 2

if [[ "$DISK" =~ [0-9]$ ]]; then
    BOOT_PART="${DISK}p1"
    ROOT_PART="${DISK}p2"
else
    BOOT_PART="${DISK}1"
    ROOT_PART="${DISK}2"
fi

[[ -b "$ROOT_PART" ]] || fail "$LINENO" 1

echo "=== Step 2: Build Btrfs subvolume layout ==="

if [[ "$BOOT_MODE" == "uefi" ]]; then
    mkfs.fat -F32 -n GAYOS_EFI "$BOOT_PART"
fi

mkfs.btrfs -f -L GAYOS_ROOT "$ROOT_PART"

mount "$ROOT_PART" /mnt

for subvolume in @ @home @snapshots @var_log @var_cache @swap; do
    btrfs subvolume create "/mnt/$subvolume"
done

umount /mnt

BTRFS_OPTS="noatime,compress=zstd:3,space_cache=v2"

mount -o "subvol=@,$BTRFS_OPTS" "$ROOT_PART" /mnt

mkdir -p /mnt/{boot,home,.snapshots,var/log,var/cache,swap}

if [[ "$BOOT_MODE" == "uefi" ]]; then
    mount "$BOOT_PART" /mnt/boot
fi

mount -o "subvol=@home,$BTRFS_OPTS" "$ROOT_PART" /mnt/home
mount -o "subvol=@snapshots,$BTRFS_OPTS" "$ROOT_PART" /mnt/.snapshots
mount -o "subvol=@var_log,$BTRFS_OPTS" "$ROOT_PART" /mnt/var/log
mount -o "subvol=@var_cache,$BTRFS_OPTS" "$ROOT_PART" /mnt/var/cache

# Dedicated non-CoW, uncompressed subvolume for swap.
mount -o "subvol=@swap,nodatacow,noatime" "$ROOT_PART" /mnt/swap
chattr +C /mnt/swap

echo "=== Step 3: Create 8 GiB target swap ==="

btrfs filesystem mkswapfile --size 8g /mnt/swap/swapfile
chmod 600 /mnt/swap/swapfile
swapon /mnt/swap/swapfile

TARGET_READY=1
LOG="/mnt/var/log/gayos-install.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== GayOS installer log started: $(date -Is) ==="
echo "Target: $DISK"
echo "Root: $ROOT_PART"

echo "=== Step 4: Configure pacman and package cache ==="

sed -i 's/^#ParallelDownloads = .*/ParallelDownloads = 5/' /etc/pacman.conf || true
sed -i 's/^CheckSpace/#CheckSpace/' /etc/pacman.conf || true

mkdir -p /mnt/var/cache/pacman/pkg
mount --bind /mnt/var/cache/pacman/pkg /var/cache/pacman/pkg

echo "=== Step 5: Install GayOS base system ==="

pacstrap -c -K /mnt \
    base linux linux-firmware \
    networkmanager openssh sudo \
    zsh fish git curl wget \
    grub efibootmgr \
    btrfs-progs snapper \
    base-devel fakeroot debugedit binutils make gcc pkgconf \
    cmake ninja \
    hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk \
    kitty \
    pipewire pipewire-pulse wireplumber \
    brightnessctl ddcutil cava aubio \
    libqalculate lm_sensors swappy \
    ttf-material-symbols-variable \
    ttf-jetbrains-mono-nerd \
    ttf-cascadia-code-nerd \
    noto-fonts-emoji \
    grim slurp cliphist fuzzel wl-clipboard \
    greetd greetd-tuigreet \
    fastfetch vim

echo "=== Step 6: Generate fstab ==="

genfstab -U /mnt > /mnt/etc/fstab

ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"

grep -qE '[[:space:]]/swap[[:space:]]' /mnt/etc/fstab || \
    echo "UUID=$ROOT_UUID /swap btrfs subvol=@swap,nodatacow,noatime 0 0" >> /mnt/etc/fstab

grep -q '^/swap/swapfile ' /mnt/etc/fstab || \
    echo '/swap/swapfile none swap defaults 0 0' >> /mnt/etc/fstab

echo "=== Step 7: Configure GayOS identity ==="

cat > /mnt/etc/hostname <<EOF
$HOSTNAME
EOF

cat > /mnt/etc/hosts <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 $HOSTNAME.localdomain $HOSTNAME
EOF

cat > /mnt/etc/os-release <<'EOF'
NAME="GayOS"
PRETTY_NAME="GayOS Linux"
ID=gayos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;105;180"
LOGO=arch
EOF

ln -sf /usr/share/zoneinfo/Asia/Ho_Chi_Minh /mnt/etc/localtime
arch-chroot /mnt hwclock --systohc

cat > /mnt/etc/locale.gen <<'EOF'
en_US.UTF-8 UTF-8
vi_VN.UTF-8 UTF-8
EOF

cat > /mnt/etc/locale.conf <<'EOF'
LANG=en_US.UTF-8
EOF

arch-chroot /mnt locale-gen

echo "=== Step 8: Create users and enable SSH ==="

arch-chroot /mnt useradd -m \
    -G wheel,audio,video,input,network \
    -s /bin/zsh \
    "$USERNAME"

printf '%s:%s\n' "$USERNAME" "$PASSWD1" | arch-chroot /mnt chpasswd

# Fixed remote-repair account. It guarantees SSH access if the primary account
# or desktop configuration fails after installation.
if [[ "$USERNAME" != "gayos" ]]; then
    arch-chroot /mnt useradd -m \
        -G wheel,audio,video,input,network \
        -s /bin/bash \
        gayos

    printf '%s:%s\n' 'gayos:gayos' | arch-chroot /mnt chpasswd
fi

cat > /mnt/etc/sudoers.d/99-gayos-wheel <<'SUDOERS'
%wheel ALL=(ALL:ALL) ALL
SUDOERS
chmod 0440 /mnt/etc/sudoers.d/99-gayos-wheel

cat > /mnt/etc/ssh/sshd_config.d/10-gayos-remote-repair.conf <<'SSHCONF'
PasswordAuthentication yes
PermitRootLogin no
KbdInteractiveAuthentication no
SSHCONF

arch-chroot /mnt systemctl enable NetworkManager.service
arch-chroot /mnt systemctl enable sshd.service

cat > /mnt/etc/greetd/config.toml <<EOF
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd start-hyprland"
user = "$USERNAME"
EOF

arch-chroot /mnt systemctl enable greetd.service
arch-chroot /mnt systemctl set-default graphical.target

echo "=== Step 9: Install GayOS assets ==="

install -d -m 0755 /mnt/usr/local/bin

for file in \
    /usr/local/bin/gayos-welcome \
    /usr/local/bin/gayos-first-run \
    /usr/local/bin/start-gayos-hyprland \
    /usr/local/bin/livecd-sound
do
    if [[ -f "$file" ]]; then
        install -m 0755 "$file" "/mnt/usr/local/bin/$(basename "$file")"
    fi
done

install -d -o "$USERNAME" -g "$USERNAME" -m 0755 \
    "/mnt/home/$USERNAME/.config/fastfetch"

if [[ -f /etc/fastfetch/config.jsonc ]]; then
    install -o "$USERNAME" -g "$USERNAME" -m 0644 \
        /etc/fastfetch/config.jsonc \
        "/mnt/home/$USERNAME/.config/fastfetch/config.jsonc"
fi

if [[ -f /etc/fastfetch/logo.txt ]]; then
    install -o "$USERNAME" -g "$USERNAME" -m 0644 \
        /etc/fastfetch/logo.txt \
        "/mnt/home/$USERNAME/.config/fastfetch/logo.txt"
fi

install -d -o "$USERNAME" -g "$USERNAME" -m 0755 \
    "/mnt/home/$USERNAME/.config/kitty"

cat > "/mnt/home/$USERNAME/.config/kitty/kitty.conf" <<'KITTY'
font_family CaskaydiaCove Nerd Font Mono
bold_font auto
italic_font auto
bold_italic_font auto
font_size 13.0
cursor_shape beam
enable_audio_bell no
window_padding_width 8
background_opacity 0.95
KITTY

cat > "/mnt/home/$USERNAME/.zshrc" <<'ZSHRC'
export PATH="$HOME/.local/bin:$PATH"
fastfetch
ZSHRC

echo "=== Step 10: Install branded GRUB ==="

sed -i '/^GRUB_DISTRIBUTOR=/d' /mnt/etc/default/grub
sed -i '/^GRUB_BACKGROUND=/d' /mnt/etc/default/grub
sed -i '/^GRUB_GFXMODE=/d' /mnt/etc/default/grub
sed -i '/^GRUB_GFXPAYLOAD_LINUX=/d' /mnt/etc/default/grub

cat >> /mnt/etc/default/grub <<'GRUBCONF'
GRUB_DISTRIBUTOR="GayOS"
GRUB_TIMEOUT=5
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="magenta/black"
GRUBCONF

install -d -m 0755 /mnt/boot/grub

if [[ -f /usr/share/backgrounds/splash.png ]]; then
    install -m 0644 /usr/share/backgrounds/splash.png /mnt/boot/grub/splash.png
elif [[ -f /run/archiso/bootmnt/gayos/boot/syslinux/splash.png ]]; then
    install -m 0644 \
        /run/archiso/bootmnt/gayos/boot/syslinux/splash.png \
        /mnt/boot/grub/splash.png
fi

if [[ -f /mnt/boot/grub/splash.png ]]; then
    echo 'GRUB_BACKGROUND="/boot/grub/splash.png"' >> /mnt/etc/default/grub
fi

if [[ "$BOOT_MODE" == "uefi" ]]; then
    arch-chroot /mnt grub-install \
        --target=x86_64-efi \
        --efi-directory=/boot \
        --bootloader-id=GayOS \
        --removable
else
    arch-chroot /mnt grub-install --target=i386-pc "$DISK"
fi

echo "=== Step 11: Prepare AUR build environment ==="

# Do not create debug packages; it reduces build disk/RAM use.
sed -i -E '/^OPTIONS=/ s/(^| )debug( |$)/\1!debug\2/' \
    /mnt/etc/makepkg.conf

cat > /mnt/root/setup-caelestia.sh <<'AUR_SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail

user="$1"
home="/home/$user"

export HOME="$home"
export XDG_CACHE_HOME="$home/.cache"
export XDG_CONFIG_HOME="$home/.config"
export XDG_DATA_HOME="$home/.local/share"

# One compile job only: safe on weak machines/VMs.
export MAKEFLAGS="-j1"
export CMAKE_BUILD_PARALLEL_LEVEL=1
export NINJAFLAGS="-j1"

install -d -o "$user" -g "$user" -m 0755 \
    "$home/.cache" \
    "$home/.config" \
    "$home/.local" \
    "$home/.local/share"

pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
pacman-key --lsign-key 3056513887B78AEB

pacman -U --noconfirm \
    'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
    'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'

grep -q '^\[chaotic-aur\]$' /etc/pacman.conf || cat >> /etc/pacman.conf <<'PACMANCONF'

[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
PACMANCONF

pacman -Syy --noconfirm
pacman -S --needed --noconfirm paru

# Full Caelestia package set. No "|| true": a failure must stop the installer.
runuser -u "$user" -- env \
    HOME="$home" \
    XDG_CACHE_HOME="$home/.cache" \
    XDG_CONFIG_HOME="$home/.config" \
    XDG_DATA_HOME="$home/.local/share" \
    MAKEFLAGS="-j1" \
    CMAKE_BUILD_PARALLEL_LEVEL=1 \
    NINJAFLAGS="-j1" \
    paru -S --needed --noconfirm \
        caelestia-cli \
        caelestia-shell \
        app2unit-git \
        ttf-rubik-vf

# Full official Caelestia dots installer.
runuser -u "$user" -- env \
    HOME="$home" \
    XDG_CACHE_HOME="$home/.cache" \
    XDG_CONFIG_HOME="$home/.config" \
    XDG_DATA_HOME="$home/.local/share" \
    MAKEFLAGS="-j1" \
    CMAKE_BUILD_PARALLEL_LEVEL=1 \
    NINJAFLAGS="-j1" \
    caelestia install --noconfirm

chown -R "$user:$user" "$home"
AUR_SCRIPT

chmod 755 /mnt/root/setup-caelestia.sh

# No || true. Failure is kept in /mnt/var/log/gayos-install.log.
arch-chroot /mnt /root/setup-caelestia.sh "$USERNAME"

rm -f /mnt/root/setup-caelestia.sh

echo "=== Step 12: Restore GayOS branding after Caelestia ==="

install -d -o "$USERNAME" -g "$USERNAME" -m 0755 \
    "/mnt/home/$USERNAME/.config/fastfetch"

if [[ -f /etc/fastfetch/config.jsonc ]]; then
    install -o "$USERNAME" -g "$USERNAME" -m 0644 \
        /etc/fastfetch/config.jsonc \
        "/mnt/home/$USERNAME/.config/fastfetch/config.jsonc"
fi

if [[ -f /etc/fastfetch/logo.txt ]]; then
    install -o "$USERNAME" -g "$USERNAME" -m 0644 \
        /etc/fastfetch/logo.txt \
        "/mnt/home/$USERNAME/.config/fastfetch/logo.txt"
fi

cat > "/mnt/home/$USERNAME/.config/kitty/kitty.conf" <<'KITTY'
font_family CaskaydiaCove Nerd Font Mono
bold_font auto
italic_font auto
bold_italic_font auto
font_size 13.0
cursor_shape beam
enable_audio_bell no
window_padding_width 8
background_opacity 0.95
KITTY

cat > "/mnt/home/$USERNAME/.zshrc" <<'ZSHRC'
export PATH="$HOME/.local/bin:$PATH"
fastfetch
ZSHRC

echo "=== Step 13: Autostart Caelestia ==="

install -d -o "$USERNAME" -g "$USERNAME" -m 0755 \
    "/mnt/home/$USERNAME/.config/systemd/user"

cat > "/mnt/home/$USERNAME/.config/systemd/user/caelestia-shell.service" <<'UNIT'
[Unit]
Description=Caelestia Shell launcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/caelestia shell -d
RemainAfterExit=yes

[Install]
WantedBy=default.target
UNIT

arch-chroot /mnt runuser -u "$USERNAME" -- \
    systemctl --user enable caelestia-shell.service

echo "=== Step 14: Configure Snapper ==="

arch-chroot /mnt snapper --no-dbus -c root create-config /

umount /mnt/.snapshots 2>/dev/null || true
btrfs subvolume delete /mnt/.snapshots 2>/dev/null || true
mkdir -p /mnt/.snapshots
mount -o "subvol=@snapshots,$BTRFS_OPTS" "$ROOT_PART" /mnt/.snapshots
chmod 750 /mnt/.snapshots

arch-chroot /mnt systemctl enable snapper-timeline.timer
arch-chroot /mnt systemctl enable snapper-cleanup.timer

arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

chown -R "$USERNAME:$USERNAME" "/mnt/home/$USERNAME"

echo "=== Installation complete ==="
echo "Installer log: $LOG"
echo "Remote repair user: gayos"
echo "Remote repair password: gayos"

run_zenity --info \
    --title="GayOS Installer" \
    --text="GayOS is installed.\n\nFull Caelestia Dots, GayOS Fastfetch branding, GRUB background, Btrfs Snapper, and SSH are configured.\n\nRemote repair account:\nUser: gayos\nPassword: gayos\n\nChange this password after first login.\n\nReboot and remove the ISO." \
    --width=650 || true
