#!/usr/bin/env bash
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [[ "${EUID}" -ne 0 ]]; then
    exec sudo -E /usr/local/bin/gayos-install "$@"
fi

REAL_USER="${SUDO_USER:-gay}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
REAL_UID="$(id -u "$REAL_USER")"

export XDG_RUNTIME_DIR="/run/user/${REAL_UID}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

run_zenity() {
    runuser -u "$REAL_USER" -- env \
        HOME="$REAL_HOME" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        zenity "$@"
}

# 1. Welcome
if ! run_zenity --question \
    --title="GayOS Installer" \
    --text="Welcome to GayOS Installer!\n\nThis will install GayOS (Btrfs + Caelestia Desktop) to your disk.\n\n⚠️ WARNING: All data on the selected disk will be erased.\n\nContinue only if you understand this." \
    --ok-label="I AM GAY" \
    --cancel-label="Cancel" \
    --width=520; then
    exit 0
fi

# 2. Select Disk
DISK=$(run_zenity --list --radiolist \
    --title="Select Disk" \
    --text="Choose the disk to install GayOS.\nAll data on this disk will be erased." \
    --column="Select" --column="Disk" \
    TRUE "$(lsblk -ndo NAME,TYPE | awk '$2=="disk"{print "/dev/"$1}' | head -1)" \
    FALSE "$(lsblk -ndo NAME,TYPE | awk '$2=="disk"{print "/dev/"$1}' | tail -n +2 | head -1)" \
    --width=400 --height=220)

if [[ -z "$DISK" ]]; then
    run_zenity --error --title="Error" --text="No disk selected. Installation aborted."
    exit 1
fi

# 3. Hostname
HOSTNAME=$(run_zenity --entry \
    --title="Hostname" \
    --text="Enter hostname for your GayOS system:" \
    --entry-text "gayos")
[[ -z "$HOSTNAME" ]] && HOSTNAME="gayos"

# 4. Username
USERNAME=$(run_zenity --entry \
    --title="Username" \
    --text="Enter your username:" \
    --entry-text "gay")
[[ -z "$USERNAME" ]] && USERNAME="gay"

# 5. Password
PASSWD1=$(run_zenity --entry --hide-text \
    --title="Password" \
    --text="Enter password for user '$USERNAME':")

PASSWD2=$(run_zenity --entry --hide-text \
    --title="Confirm Password" \
    --text="Confirm password for user '$USERNAME':")

if [[ "$PASSWD1" != "$PASSWD2" ]]; then
    run_zenity --error --title="Error" --text="Passwords do not match. Installation aborted."
    exit 1
fi
USER_PASSWORD="$PASSWD1"

echo "=== Step 1: Wiping disk $DISK ==="
swapoff -a || true
umount -R /mnt 2>/dev/null || true
dd if=/dev/zero of="$DISK" bs=1M count=100 conv=notrunc || true
wipefs -a "$DISK" || true

IS_UEFI=false
if [[ -d /sys/firmware/efi ]]; then
    IS_UEFI=true
    echo "Boot mode: UEFI"
else
    echo "Boot mode: BIOS (Legacy)"
fi

echo "=== Step 2: Partitioning ==="
if [[ "$IS_UEFI" = true ]]; then
    sgdisk --clear "$DISK" \
        --new=1:1M:+512M --typecode=1:EF00 --change-name=1:"EFI" \
        --new=2:0:0 --typecode=2:8300 --change-name=2:"ROOT" \
        >/dev/null
else
    sgdisk --clear "$DISK" \
        --new=1:1M:+2M --typecode=1:EF02 --change-name=1:"BIOSBOOT" \
        --new=2:0:0 --typecode=2:8300 --change-name=2:"ROOT" \
        >/dev/null
fi

partprobe "$DISK" || udevadm settle || true
sleep 2

if [[ "$DISK" =~ [0-9]$ ]]; then
    BOOT_PART="${DISK}p1"
    ROOT_PART="${DISK}p2"
else
    BOOT_PART="${DISK}1"
    ROOT_PART="${DISK}2"
fi

echo "=== Step 3: Formatting & Btrfs Subvolumes ==="
if [[ "$IS_UEFI" = true ]]; then
    mkfs.fat -F32 "$BOOT_PART"
fi
mkfs.btrfs -f "$ROOT_PART"

mkdir -p /mnt
mount "$ROOT_PART" /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
btrfs subvolume create /mnt/@snapshots
btrfs subvolume create /mnt/@var_log
btrfs subvolume create /mnt/@var_cache
btrfs subvolume create /mnt/@swap
umount /mnt

mount -o subvol=@,compress=zstd "$ROOT_PART" /mnt
mkdir -p /mnt/{boot,home,.snapshots,var/log,var/cache,swap,var/cache/pacman/pkg}
if [[ "$IS_UEFI" = true ]]; then
    mount "$BOOT_PART" /mnt/boot
fi
mount -o subvol=@home,compress=zstd "$ROOT_PART" /mnt/home
mount -o subvol=@snapshots,compress=zstd "$ROOT_PART" /mnt/.snapshots
mount -o subvol=@var_log,compress=zstd "$ROOT_PART" /mnt/var/log
mount -o subvol=@var_cache,compress=zstd "$ROOT_PART" /mnt/var/cache
mount -o subvol=@swap "$ROOT_PART" /mnt/swap

# Tạo swapfile 2GB chống thiếu RAM khi cài đặt
btrfs filesystem mkswapfile --size 2g /mnt/swap/swapfile || true
swapon /mnt/swap/swapfile || true

echo "=== Step 4: Setup Pacman Live Environment ==="
sed -i 's/^CheckSpace/#CheckSpace/' /etc/pacman.conf || true
sed -i 's/^#ParallelDownloads = 5/ParallelDownloads = 5/' /etc/pacman.conf || true

mkdir -p /mnt/var/cache/pacman/pkg
mount --bind /mnt/var/cache/pacman/pkg /var/cache/pacman/pkg

echo "=== Step 5: pacstrap base packages ==="
pacstrap -c -K /mnt \
    base linux linux-firmware \
    base-devel networkmanager sudo zsh fish git \
    grub efibootmgr \
    btrfs-progs snapper \
    hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk \
    kitty \
    pipewire pipewire-pulse wireplumber \
    brightnessctl ddcutil cava aubio \
    libqalculate lm_sensors swappy \
    ttf-material-symbols-variable ttf-jetbrains-mono-nerd ttf-cascadia-code-nerd noto-fonts-cjk noto-fonts-emoji \
    grim slurp cliphist fuzzel wl-clipboard \
    greetd greetd-tuigreet \
    vim neovim fastfetch

echo "=== Step 6: Generating fstab ==="
genfstab -U /mnt > /mnt/etc/fstab

echo "=== Step 7: Configuring System & GayOS Branding ==="
cat > /mnt/etc/hostname <<EOF
$HOSTNAME
EOF

cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.0.1   $HOSTNAME
EOF

cat > /mnt/etc/os-release <<'OSREL'
NAME="GayOS"
PRETTY_NAME="GayOS Linux"
ID=gayos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;105;180"
HOME_URL="https://github.com/gayos"
SUPPORT_URL="https://github.com/gayos"
BUG_REPORT_URL="https://github.com/gayos"
LOGO=arch
OSREL

ln -sf /usr/share/zoneinfo/Asia/Ho_Chi_Minh /mnt/etc/localtime
hwclock --systohc --utc

cat > /mnt/etc/locale.conf <<EOF
LANG=en_US.UTF-8
EOF
echo "en_US.UTF-8 UTF-8" > /mnt/etc/locale.gen
arch-chroot /mnt locale-gen

echo "=== Step 8: Installing GRUB with GayOS Name ==="
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="GayOS"/' /mnt/etc/default/grub || true

if [[ "$IS_UEFI" = true ]]; then
    arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GayOS --removable
else
    arch-chroot /mnt grub-install --target=i386-pc "$DISK"
fi
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

echo "=== Step 9: Sudo & User Setup ==="
mkdir -p /mnt/etc/sudoers.d
cat > /mnt/etc/sudoers.d/99-wheel <<'SUDOERS'
%wheel ALL=(ALL:ALL) ALL
%wheel ALL=(ALL:ALL) NOPASSWD: ALL
SUDOERS
chmod 0440 /mnt/etc/sudoers.d/99-wheel

arch-chroot /mnt useradd -m -G wheel,audio,video,input,network -s /bin/zsh "$USERNAME"
echo "$USERNAME:$USER_PASSWORD" | arch-chroot /mnt chpasswd

# Auto login qua greetd vào Hyprland
mkdir -p /mnt/etc/greetd
cat > /mnt/etc/greetd/config.toml <<EOF
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd start-hyprland"
user = "$USERNAME"
EOF

# Cấu hình ZSH không bị popup setup lần đầu
cat > "/mnt/home/$USERNAME/.zshrc" <<'ZSHRC'
export PATH="$HOME/.local/bin:$PATH"
fastfetch
ZSHRC

# Cấu hình Fastfetch hiển thị Logo Arch/GayOS chuẩn
mkdir -p "/mnt/home/$USERNAME/.config/fastfetch"
cat > "/mnt/home/$USERNAME/.config/fastfetch/config.jsonc" <<'FFJSON'
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": {
            "right": 2
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
FFJSON

# Cấu hình Kitty chuẩn font Nerd Font
mkdir -p "/mnt/home/$USERNAME/.config/kitty"
cat > "/mnt/home/$USERNAME/.config/kitty/kitty.conf" <<'KITTY'
font_family      CaskaydiaCove Nerd Font Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.5

cursor_shape     beam
enable_audio_bell no
window_padding_width 8
background_opacity 0.95
KITTY

arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

echo "=== Step 10: Setup Chaotic-AUR & Installing Caelestia Shell ==="
cat > /mnt/root/setup-desktop.sh <<'AUR_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
user="$1"
home="/home/$user"

export HOME="$home"

# 1. Cài đặt kho Chaotic-AUR
pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com || true
pacman-key --lsign-key 3056513887B78AEB || true
pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst' || true

if ! grep -q "\[chaotic-aur\]" /etc/pacman.conf; then
    cat >> /etc/pacman.conf <<'EOF'

[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
EOF
fi

pacman -Sy --noconfirm

# 2. Cài đặt Paru và Quickshell trực tiếp từ repo
pacman -S --needed --noconfirm paru quickshell || true

# 3. Dùng Paru để cài đặt trọn bộ Caelestia Shell từ AUR
runuser -u "$user" -- paru -S --needed --noconfirm \
    caelestia-shell \
    caelestia-cli-git \
    app2unit-git \
    ttf-rubik-vf

# 4. Tạo config shell tối giản
mkdir -p "$home/.config/caelestia"
printf '{}\n' > "$home/.config/caelestia/shell.json"

chown -R "$user:$user" "$home/.config" "$home/.cache" "$home/.local" 2>/dev/null || true
AUR_SCRIPT

chmod 755 /mnt/root/setup-desktop.sh
arch-chroot /mnt /root/setup-desktop.sh "$USERNAME"
rm -f /mnt/root/setup-desktop.sh

# Cấu hình Autostart Caelestia qua Hyprland
mkdir -p "/mnt/home/$USERNAME/.config/hypr"
cat > "/mnt/home/$USERNAME/.config/hypr/hyprland.lua" <<'HYPRLUA'
-- GayOS Default Hyprland Config
hl.config({
    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 2,
        ["col.active_border"] = "rgba(ff69b4ee) rgba(00d4ffee) 45deg",
        ["col.inactive_border"] = "rgba(595959aa)",
    },
    decoration = {
        rounding = 8,
    },
})

hl.bind("SUPER + Q", function()
    hl.exec_cmd("kitty")
end)

hl.bind("SUPER + D", function()
    hl.exec_cmd("fuzzel")
end)

hl.bind("SUPER + C", function()
    hl.dispatch(hl.dsp.window.close())
end)

hl.bind("SUPER + M", function()
    hl.dispatch(hl.dsp.exit())
end)

hl.on("hyprland.start", function()
    hl.exec_cmd("caelestia shell -d")
end)
HYPRLUA

arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

echo "=== Step 11: Configuring Snapper ==="
umount /mnt/.snapshots 2>/dev/null || true
rm -rf /mnt/.snapshots
arch-chroot /mnt snapper --no-dbus -c root create-config / || true
btrfs subvolume delete /mnt/.snapshots 2>/dev/null || true
mkdir -p /mnt/.snapshots
mount -o subvol=@snapshots,compress=zstd "$ROOT_PART" /mnt/.snapshots
chmod 750 /mnt/.snapshots

echo "=== Step 12: Enabling Services ==="
arch-chroot /mnt systemctl enable NetworkManager.service
arch-chroot /mnt systemctl enable greetd.service
arch-chroot /mnt systemctl enable snapper-timeline.timer || true
arch-chroot /mnt systemctl enable snapper-cleanup.timer || true
arch-chroot /mnt systemctl set-default graphical.target

umount /var/cache/pacman/pkg 2>/dev/null || true

echo "=== Installation Finished ==="
run_zenity --info \
    --title="GayOS Installer" \
    --text="GayOS with Paru and Caelestia Desktop has been installed successfully!\n\nPlease reboot your system now."
